{
  "__inputs": [
    {
      "name": "DS_METRICS",
      "label": "Metrics (Prometheus)",
      "description": "Prometheus data source that scrapes the container /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "rtd-simple performance dashboard",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "headroom",
        "label": "CPU headroom target (%)",
        "type": "custom",
        "query": "60,65,70,75,80,85",
        "includeAll": false,
        "multi": false,
        "current": { "selected": true, "text": "70", "value": "70" },
        "options": [
          { "selected": false, "text": "60", "value": "60" },
          { "selected": false, "text": "65", "value": "65" },
          { "selected": true, "text": "70", "value": "70" },
          { "selected": false, "text": "75", "value": "75" },
          { "selected": false, "text": "80", "value": "80" },
          { "selected": false, "text": "85", "value": "85" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "### Peak-oriented overview\nThis view reports **peak**, not average. A fleet's safe capacity is set by its **hottest pod** and its **worst-case latency** (the lowest common denominator), not by the comfortable average that hides a saturating pod. Size QPS so that even the peak stays within the 5 ms p95 SLA with headroom. The **Safe fleet QPS** tile estimates the total QPS at which the hottest pod would sit at the **CPU headroom target** set by the `$headroom`% dropdown at the top left."
      }
    },
    {
      "id": 2,
      "title": "Peak CPU % (hottest pod, over range)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["max"], "fields": "" }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "max(100 * rate(rtd_simple_cpu_seconds_total[5m]) / rtd_simple_cpu_limit_cores)" }
      ]
    },
    {
      "id": 3,
      "title": "Peak memory % (hottest pod, over range)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["max"], "fields": "" }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "max(rtd_simple_memory_percent)" }
      ]
    },
    {
      "id": 4,
      "title": "Peak response time p99 (fleet, over range)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 4 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["max"], "fields": "" }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(rpc_server_duration_bucket{rpc_method=\"GetMutations\"}[5m]))) * 1000" }
      ]
    },
    {
      "id": 5,
      "title": "Safe fleet QPS (hottest pod at $headroom%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["min"], "fields": "" }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "sum(rate(rpc_server_duration_count{rpc_method=\"GetMutations\"}[5m])) * $headroom / max(100 * rate(rtd_simple_cpu_seconds_total[5m]) / rtd_simple_cpu_limit_cores)" }
      ]
    },
    {
      "id": 6,
      "title": "Average CPU % per pod (shaded band shows the max/min range; the peak edge is the ceiling, 5 ms SLA headroom line at 85%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 85 } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "peak (hottest pod)" }, "properties": [ { "id": "custom.fillBelowTo", "value": "min (coolest pod)" }, { "id": "custom.fillOpacity", "value": 12 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }, { "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } } ] },
          { "matcher": { "id": "byName", "options": "min (coolest pod)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }, { "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } } ] },
          { "matcher": { "id": "byName", "options": "avg (all pods)" }, "properties": [ { "id": "custom.lineWidth", "value": 2 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "avg(100 * rate(rtd_simple_cpu_seconds_total[5m]) / rtd_simple_cpu_limit_cores)", "legendFormat": "avg (all pods)" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "max(100 * rate(rtd_simple_cpu_seconds_total[5m]) / rtd_simple_cpu_limit_cores)", "legendFormat": "peak (hottest pod)" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "min(100 * rate(rtd_simple_cpu_seconds_total[5m]) / rtd_simple_cpu_limit_cores)", "legendFormat": "min (coolest pod)" }
      ]
    },
    {
      "id": 7,
      "title": "Peak response time over time (p99 and p95, fleet) — 5 ms SLA line",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 6, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 5 } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [ { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(rpc_server_duration_bucket{rpc_method=\"GetMutations\"}[5m]))) * 1000", "legendFormat": "p99" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_server_duration_bucket{rpc_method=\"GetMutations\"}[5m]))) * 1000", "legendFormat": "p95" }
      ]
    },
    {
      "id": 8,
      "title": "QPS (total)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "sum(rate(rpc_server_duration_count{rpc_method=\"GetMutations\"}[5m]))", "legendFormat": "total" }
      ]
    },
    {
      "id": 9,
      "title": "Average QPS per pod (shaded band shows the max/min range across pods)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max (busiest pod)" }, "properties": [ { "id": "custom.fillBelowTo", "value": "min (quietest pod)" }, { "id": "custom.fillOpacity", "value": 12 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }, { "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } } ] },
          { "matcher": { "id": "byName", "options": "min (quietest pod)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }, { "id": "custom.lineStyle", "value": { "dash": [6, 6], "fill": "dash" } } ] },
          { "matcher": { "id": "byName", "options": "avg per pod" }, "properties": [ { "id": "custom.lineWidth", "value": 2 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "avg(sum by (pod) (rate(rpc_server_duration_count{rpc_method=\"GetMutations\"}[5m])))", "legendFormat": "avg per pod" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "max(sum by (pod) (rate(rpc_server_duration_count{rpc_method=\"GetMutations\"}[5m])))", "legendFormat": "max (busiest pod)" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" }, "expr": "min(sum by (pod) (rate(rpc_server_duration_count{rpc_method=\"GetMutations\"}[5m])))", "legendFormat": "min (quietest pod)" }
      ]
    }
  ]
}
