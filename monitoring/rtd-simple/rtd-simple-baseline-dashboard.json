{
  "__inputs": [
    {
      "name": "DS_METRICS",
      "label": "Metrics (Prometheus)",
      "description": "Prometheus data source that scrapes the container /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "rtd-simple baseline",
  "uid": "rtd-simple-baseline",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "CPU % of allocation",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
          "expr": "100 * sum(rate(rtd_simple_cpu_seconds_total[5m])) / sum(rtd_simple_cpu_limit_cores)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory % of allocation",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
          "expr": "avg(rtd_simple_memory_percent)"
        }
      ]
    },
    {
      "id": 3,
      "title": "QPS (GetMutations)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
          "expr": "sum(rate(rpc_server_duration_count{rpc_method=\"GetMutations\"}[1m]))",
          "legendFormat": "qps"
        }
      ]
    },
    {
      "id": 4,
      "title": "Response time (avg and p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
          "expr": "sum(rate(rpc_server_duration_sum[5m])) / sum(rate(rpc_server_duration_count[5m]))",
          "legendFormat": "avg"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_METRICS}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_server_duration_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
